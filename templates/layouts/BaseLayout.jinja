{#def
    user: DetailedUser | None = None,
    title="AudiobookRequest",
    hide_navbar=False,
    full_height: bool = False,
#}

<!DOCTYPE html>
<html lang="en" data-theme="garden">
    <head>
        <meta charset="UTF-8" />

        <title>
            {{ title }}
        </title>
        <meta name="description"
              content="AudioBookRequest - Your platform for managing audiobook requests." />
        <meta name="keywords"
              content="audiobooks, requests, wishlist, search, settings" />

        <link rel="stylesheet"
              href="{{ base_url }}/static/globals.css?v={{ version }}" />
        <script src="{{ base_url }}/static/htmx.js?v={{ version }}"></script>
        <script defer src="{{ base_url }}/static/htmx-preload.js?v={{ version }}"></script>
        <script>
            const setTheme = theme => {
                if (!theme) {
                    theme = localStorage.getItem("theme");
                    if (!theme) {
                        theme = window.matchMedia("(prefers-color-scheme: dark)").matches ?
                            "night" :
                            "nord";
                    }
                }
                document.documentElement.setAttribute("data-theme", theme);
                localStorage.setItem("theme", theme);
                if (theme === "night") {
                    for (const elem of document.getElementsByClassName(
                            "light-dark-toggle",
                        )) {
                        elem.classList.add("DARKCLASS");
                        document.documentElement.classList.add("dark");
                    }
                } else {
                    for (const elem of document.getElementsByClassName(
                            "light-dark-toggle",
                        )) {
                        elem.classList.remove("DARKCLASS");
                        document.documentElement.classList.remove("dark");
                    }
                }
            };
            const toggleTheme = () => {
                const theme = document.documentElement.getAttribute("data-theme");

                const newTheme = theme === "nord" ? "night" : "nord";
                setTheme(newTheme);
            };
        </script>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="apple-touch-icon"
              sizes="180x180"
              href="{{ base_url }}/static/apple-touch-icon.png?v={{ version }}" />
        <link rel="icon"
              sizes="any"
              type="image/svg+xml"
              href="{{ base_url }}/static/favicon.svg?v={{ version }}" />
        <link rel="icon"
              type="image/png"
              sizes="32x32"
              href="{{ base_url }}/static/favicon-32x32.png?v={{ version }}" />
        <link rel="icon"
              type="image/png"
              sizes="16x16"
              href="{{ base_url }}/static/favicon-16x16.png?v={{ version }}" />
        <link rel="manifest"
              href="{{ base_url }}/static/site.webmanifest?v={{ version }}" />

        <js.Toast />

    </head>
    <body class="w-screen flex flex-col overflow-x-hidden {% if full_height %}overflow-hidden{% else %}min-h-screen{% endif %}"
          {% if full_height %}style="height: 100vh; height: 100dvh; overflow: hidden"{% endif %}
          hx-ext="preload">

        <ToastBlock init />

        <script>
            // execute the script once here (to have it run on all pages), and once when the button loads below in the navbar
            setTheme();
        </script>
        {% if not hide_navbar %}
            <header class="shadow-lg">
                <nav class="navbar">
                    <div class="flex-1 flex items-center gap-1">
                        <a preload
                           href="{{ base_url }}/"
                           class="btn btn-ghost text-lg hidden sm:inline-flex">
                            AudioBookRequest
                        </a>
                        <a preload
                           href="{{ base_url }}/"
                           class="btn btn-ghost text-lg sm:hidden">
                            ABR
                        </a>
                        <a preload
                           href="{{ base_url }}/search"
                           class="btn btn-ghost h-auto min-h-12 px-2 py-1 flex-col gap-0 font-normal hidden sm:inline-flex">
                            <icons.Search />
                            <span class="text-xs">Search</span>
                        </a>
                        <a preload
                           href="{{ base_url }}/wishlist"
                           class="btn btn-ghost h-auto min-h-12 px-2 py-1 flex-col gap-0 font-normal hidden sm:inline-flex">
                            <icons.Checklist />
                            <span class="text-xs">
                                {% if user.is_admin() %}
                                    Requests
                                {% else %}
                                    My requests
                                {% endif %}
                            </span>
                        </a>
                        <span hx-get="{{ base_url }}/wishlist/stages/hx-status"
                              hx-trigger="load"
                              hx-swap="outerHTML"></span>
                    </div>
                    <div class="flex-none flex items-center gap-1 pr-2 sm:pr-4">
                        {% if user.is_admin() %}
                            <span hx-get="{{ base_url }}/wishlist/stages/hx-badge"
                                  hx-trigger="load"
                                  hx-swap="outerHTML"></span>
                        {% endif %}
                        <button class="btn btn-ghost h-auto min-h-12 px-2 py-1 flex-col gap-0 font-normal light-dark-toggle"
                                onclick="toggleTheme()">
                            <script>
                                setTheme();
                            </script>
                            <span class="theme-dark svg-dark">
                                <icons.Moon />
                            </span>
                            <span class="theme-light svg-light">
                                <icons.Sun />
                            </span>
                            <span class="text-xs">Theme</span>
                        </button>
                        <a preload
                           href="{{ base_url }}/settings/account"
                           class="btn btn-ghost h-auto min-h-12 px-2 py-1 flex-col gap-0 font-normal hidden sm:inline-flex">
                            <icons.Settings />
                            <span class="text-xs">Settings</span>
                        </a>
                        {% if user.can_logout() %}
                            <button hx-post="{{ base_url }}/auth/logout"
                                    class="btn btn-ghost h-auto min-h-12 px-2 py-1 flex-col gap-0 font-normal">
                                <icons.DoorExit />
                                <span class="text-xs">Sign out</span>
                            </button>
                        {% endif %}
                    </div>
                </nav>
            </header>
        {% endif %}

        {{ content }}

        {% if not hide_navbar %}
            {# phones: the main places as a labelled bar along the bottom #}
            <div class="h-16 shrink-0 sm:hidden">
            </div>
            <nav aria-label="Main"
                 class="sm:hidden fixed bottom-0 inset-x-0 z-40 flex justify-around bg-base-100 border-t border-base-300">
                <a preload
                   href="{{ base_url }}/"
                   class="btn btn-ghost h-auto min-h-14 grow px-1 py-1 flex-col gap-0 font-normal rounded-none">
                    <icons.Home />
                    <span class="text-xs">Home</span>
                </a>
                <a preload
                   href="{{ base_url }}/search"
                   class="btn btn-ghost h-auto min-h-14 grow px-1 py-1 flex-col gap-0 font-normal rounded-none">
                    <icons.Search />
                    <span class="text-xs">Search</span>
                </a>
                <a preload
                   href="{{ base_url }}/wishlist"
                   class="btn btn-ghost h-auto min-h-14 grow px-1 py-1 flex-col gap-0 font-normal rounded-none relative">
                    <icons.Checklist />
                    <span class="text-xs">
                        {% if user.is_admin() %}
                            Requests
                        {% else %}
                            My requests
                        {% endif %}
                    </span>
                    <span hx-get="{{ base_url }}/wishlist/stages/hx-status?compact=true"
                          hx-trigger="load"
                          hx-swap="outerHTML"></span>
                </a>
                <a preload
                   href="{{ base_url }}/settings/account"
                   class="btn btn-ghost h-auto min-h-14 grow px-1 py-1 flex-col gap-0 font-normal rounded-none">
                    <icons.Settings />
                    <span class="text-xs">Settings</span>
                </a>
            </nav>
        {% endif %}

    </body>
</html>
