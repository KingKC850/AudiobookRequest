{#def
    user: DetailedUser,
    title: str,
    detail: str,
#}

<BaseLayout title="Series" user={{ user }}>
<div class="w-full flex flex-col items-center gap-3 p-6 sm:p-8 text-center">
    <h1 class="text-3xl font-bold">
        {{ title }}
    </h1>
    <p class="text-sm opacity-70 max-w-md">
        {{ detail }}. Audible may not list this series in the selected store, or it did not answer. Try again in a moment, or search for one of its books.
    </p>
    <a preload href="{{ base_url }}/search" class="btn">Back to search</a>
</div>
</BaseLayout>
